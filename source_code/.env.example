# Database Credentials
POSTGRES_USER=mycoinflips
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=mycoinflips

# Prisma connection inside Docker (service name: db)
DATABASE_URL=postgresql://mycoinflips:CHANGE_ME@db:5432/mycoinflips?schema=public

# Backend Config
PORT=3000
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
FRONTEND_URL=https://mcfoption.com

# Resend / Outbound Email
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxx
EMAIL_FROM=no-reply@mcfoption.com
EMAIL_SUPPORT=support@mcfoption.com
EMAIL_ADMIN=admin@mcfoption.com

# Frontend API URL
VITE_API_URL=https://mcfoption.com/api

# GitHub Backup
GITHUB_USER=bebeksalju
GITHUB_TOKEN=YOUR_GITHUB_PERSONAL_ACCESS_TOKEN
GITHUB_REPO=mycoinflips

# Telegram
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
TELEGRAM_CHAT_ID=YOUR_TELEGRAM_CHAT_ID
